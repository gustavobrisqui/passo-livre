# Copie para .env (ou rode scripts/gerar-env.sh, que gera valores aleatórios).
# O .env NUNCA vai para o Git. Na VM ele é escrito pelo cloud-init com chmod 600.

# Endereço do site. Local: ":8080" (HTTP). Produção: o DNS da Azure (HTTPS automático).
SITE_ADDRESS=:8080
HTTP_PORT=8080
HTTPS_PORT=8443

# Tag das imagens no GHCR (o pipeline usa o SHA do commit). "local" = build local.
IMAGE_TAG=local

# Tokens de integração (RPA e robô do Maker Lab). Gere com: openssl rand -hex 24
RPA_TOKEN=troque-me
ROBO_TOKEN=troque-me

# Basic auth do /metrics/* (Prometheus). METRICS_HASH é o bcrypt da senha:
#   docker run --rm caddy:2.11.9-alpine caddy hash-password --bcrypt-cost 10 --plaintext 'SENHA'
# (entre aspas simples no .env, porque o hash contém "$")
METRICS_USER=prometheus
METRICS_HASH=

# Popular o banco com 20 relatos SIMULADOS de demonstração quando estiver vazio.
SEED_DEMO=true
RATE_LIMIT_POR_MINUTO=10
