{
 "uid": "passo-livre",
 "title": "Passo Livre — Golden Signals",
 "tags": [
  "passo-livre",
  "gs-fiap"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "alvo",
    "label": "Ambiente",
    "type": "custom",
    "query": "azure,local",
    "current": {
     "text": "azure",
     "value": "azure"
    },
    "options": [
     {
      "text": "azure",
      "value": "azure",
      "selected": true
     },
     {
      "text": "local",
      "value": "local",
      "selected": false
     }
    ]
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Visão geral",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Disponibilidade (alvos UP)",
   "description": "1 = todos os alvos coletados (web e api).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bool_yes_no",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "auto"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "min(up{alvo=\"$alvo\"})"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Tráfego (req/s)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "auto"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(caddy_http_request_duration_seconds_count{handler=\"headers\",alvo=\"$alvo\"}[5m]))"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Erros 5xx",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.01
       },
       {
        "color": "red",
        "value": 0.05
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "auto"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(rate(caddy_http_request_duration_seconds_count{handler=\"headers\",alvo=\"$alvo\",code=~\"5..\"}[5m])) or vector(0)) / sum(rate(caddy_http_request_duration_seconds_count{handler=\"headers\",alvo=\"$alvo\"}[5m]))"
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Latência p95",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.5
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "auto"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(caddy_http_request_duration_seconds_bucket{handler=\"headers\",alvo=\"$alvo\"}[5m])))"
    }
   ]
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Memória da API",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 150000000.0
       },
       {
        "color": "red",
        "value": 200000000.0
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "auto"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(process_resident_memory_bytes{job=~\"api|api-local\",alvo=\"$alvo\"})"
    }
   ]
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Relatos criados (24h)",
   "description": "Indicador de negócio/impacto: novos relatos de cidadãos e do robô.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "auto"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(passolivre_http_requests_total{handler=\"/api/relatos\",method=\"POST\",status=\"201\",alvo=\"$alvo\"}[24h])) or vector(0)"
    }
   ]
  },
  {
   "id": 8,
   "type": "row",
   "title": "As 4 golden signals",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "1. Tráfego — requisições por segundo por código HTTP",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (code) (rate(caddy_http_request_duration_seconds_count{handler=\"headers\",alvo=\"$alvo\"}[1m]))",
     "legendFormat": "HTTP {{code}}"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "2. Erros — % de respostas 4xx e 5xx",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(rate(caddy_http_request_duration_seconds_count{handler=\"headers\",alvo=\"$alvo\",code=~\"5..\"}[1m])) or vector(0)) / sum(rate(caddy_http_request_duration_seconds_count{handler=\"headers\",alvo=\"$alvo\"}[1m]))",
     "legendFormat": "5xx"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(rate(caddy_http_request_duration_seconds_count{handler=\"headers\",alvo=\"$alvo\",code=~\"4..\"}[1m])) or vector(0)) / sum(rate(caddy_http_request_duration_seconds_count{handler=\"headers\",alvo=\"$alvo\"}[1m]))",
     "legendFormat": "4xx"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "3. Latência — p50 / p95 / p99 (borda) e p95 da API",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.50, sum by (le) (rate(caddy_http_request_duration_seconds_bucket{handler=\"headers\",alvo=\"$alvo\"}[5m])))",
     "legendFormat": "p50 site"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(caddy_http_request_duration_seconds_bucket{handler=\"headers\",alvo=\"$alvo\"}[5m])))",
     "legendFormat": "p95 site"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(caddy_http_request_duration_seconds_bucket{handler=\"headers\",alvo=\"$alvo\"}[5m])))",
     "legendFormat": "p99 site"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(passolivre_http_request_duration_seconds_bucket{alvo=\"$alvo\"}[5m])))",
     "legendFormat": "p95 API"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "4. Saturação — requisições em andamento, CPU e memória",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(caddy_http_requests_in_flight{handler=\"headers\",alvo=\"$alvo\"})",
     "legendFormat": "em andamento (site)"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(process_cpu_seconds_total{job=~\"api|api-local\",alvo=\"$alvo\"}[1m])",
     "legendFormat": "CPU da API (núcleos)"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "process_resident_memory_bytes{job=~\"api|api-local\",alvo=\"$alvo\"} / (256*1024*1024)",
     "legendFormat": "memória da API / limite 256 MB"
    }
   ]
  },
  {
   "id": 13,
   "type": "row",
   "title": "Disponibilidade e alertas",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Alvos coletados (1 = UP)",
   "description": "",
   "datasource": {
    "type": "prometheus",
