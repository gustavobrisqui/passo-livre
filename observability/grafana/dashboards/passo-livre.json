     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "up{alvo=\"$alvo\"}",
     "legendFormat": "{{job}}"
    }
   ]
  },
  {
   "id": 15,
   "type": "alertlist",
   "title": "Alertas ativos",
   "gridPos": {
    "x": 12,
    "y": 23,
    "w": 12,
    "h": 8
   },
   "options": {
    "viewMode": "list",
    "showInstances": true,
    "groupMode": "default",
    "maxItems": 20,
    "sortOrder": 1,
    "stateFilter": {
     "firing": true,
     "pending": true,
     "normal": false,
     "error": true,
     "noData": false
    },
    "alertInstanceLabelFilter": "",
    "datasource": "Prometheus",
    "dashboardAlerts": false,
    "alertName": ""
   }
  }
 ]
}